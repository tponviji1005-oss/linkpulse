generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links Link[]

  @@map("users")
}

model Link {
  id           String    @id @default(uuid()) @db.Uuid
  shortCode    String    @unique @map("short_code") @db.VarChar(20)
  originalUrl  String    @map("original_url") @db.Text
  title        String?   @db.VarChar(255)
  userId       String    @map("user_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  maxClicks    Int?
  isFlagged    Boolean   @default(false) @map("is_flagged")
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks Click[]
  geoRules GeoRule[]
  deviceRules DeviceRule[]
  abVariants ABVariant[]

  @@index([userId])
  @@index([createdAt])
  @@map("links")
}

model GeoRule {
  id             String   @id @default(uuid()) @db.Uuid
  linkId         String   @map("link_id") @db.Uuid
  countryCode    String   @map("country_code") @db.VarChar(2)
  destinationUrl String   @map("destination_url") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, countryCode])
  @@index([linkId])
  @@map("geo_rules")
}

model DeviceRule {
  id             String   @id @default(uuid()) @db.Uuid
  linkId         String   @map("link_id") @db.Uuid
  deviceType     String   @map("device_type") @db.VarChar(20)
  destinationUrl String   @map("destination_url") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, deviceType])
  @@index([linkId])
  @@map("device_rules")
}

model ABVariant {
  id             String   @id @default(uuid()) @db.Uuid
  linkId         String   @map("link_id") @db.Uuid
  destinationUrl String   @map("destination_url") @db.Text
  weight         Int      @db.SmallInt
  label          String?  @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@map("ab_variants")
}

model Click {
  id              String   @id @default(uuid()) @db.Uuid
  linkId          String   @map("link_id") @db.Uuid
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.Text
  referer         String?  @db.Text
  country         String?  @db.VarChar(2)
  city            String?  @db.VarChar(100)
  device          String?  @db.VarChar(20)
  browser         String?  @db.VarChar(50)
  browserVersion  String?  @map("browser_version") @db.VarChar(20)
  os              String?  @db.VarChar(50)
  osVersion       String?  @map("os_version") @db.VarChar(20)
  language        String?  @map("language") @db.VarChar(10)
  latitude        Float?
  longitude       Float?
  region          String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  timezone        String?  @db.VarChar(50)
  isBot           Boolean  @default(false) @map("is_bot")
  redirectType    String?  @map("redirect_type") @db.VarChar(20)
  abVariantLabel  String?  @map("ab_variant_label") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([linkId, createdAt])
  @@index([linkId, ipAddress, createdAt])
  @@index([country])
  @@index([createdAt])
  @@map("clicks")
}
